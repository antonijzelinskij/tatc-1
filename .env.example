# ─── Node / RPC ───────────────────────────────────────────────────────────────
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MAINNET_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ─── Wallet ───────────────────────────────────────────────────────────────────
# Never commit the real key. Use a dedicated hot wallet with limited funds.
PRIVATE_KEY=0xdeadbeef...

# ─── Deployed contract ────────────────────────────────────────────────────────
EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Bot parameters ───────────────────────────────────────────────────────────
MAX_ETH_PER_SNIPE=100000000000000000      # 0.1 ETH in wei
MIN_LIQUIDITY_ETH=1000000000000000000    # 1 ETH minimum pool size
MAX_TAX_BPS=500                           # 5% max sell tax
BRIBE_PERCENTAGE=50                       # 50% of estimated profit goes to validator

# ─── Flashbots ────────────────────────────────────────────────────────────────
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
# Separate key just for Flashbots reputation (can be any key, not your main one)
FLASHBOTS_SIGNER_KEY=0xdeadbeef...

# ─── Foundry / Verification ───────────────────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
